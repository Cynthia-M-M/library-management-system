{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "baseUrl": "./",
    "paths": {
      "@prisma/client": [
        "node_modules/@prisma/client",
        "api/node_modules/@prisma/client"
      ]
    }
  },
  "include": [
    "api/src/**/*",
    "api/prisma/**/*"
  ]
}
