{
  "name": "library-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Library Management System with React, NestJS, and Prisma",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "build": "npm run build --prefix api",
    "start": "npm run start:dev --prefix api",
    "start:api": "npm run start:dev --prefix api",
    "prisma:generate": "prisma generate --schema=api/prisma/schema.prisma",
    "prisma:migrate": "npm run prisma:migrate --prefix api",
    "prisma:seed": "npm run prisma:seed --prefix api",
    "prisma:studio": "npx prisma studio --schema=api/prisma/schema.prisma"
  }
}
