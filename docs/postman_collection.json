{
  "info": {
    "_postman_id": "a9b3d4f1-6789-4e12-8901-week2collection",
    "name": "Library Management System API - Week 2",
    "description": "Postman collection covering all Week 2 endpoints: Authentication, Roles & Guards, Genre CRUD, Book Search & Pagination, and User Profile.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "librarianToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "patronToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Patron",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newpatron@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"PATRON\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new patron user and returns an accessToken."
          }
        },
        {
          "name": "Register Librarian",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newlibrarian@library.com\",\n  \"password\": \"password123\",\n  \"role\": \"LIBRARIAN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new librarian account with LIBRARIAN role."
          }
        },
        {
          "name": "Login as Librarian",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "    pm.collectionVariables.set('librarianToken', res.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@library.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in as seeded librarian and saves token to {{librarianToken}}."
          }
        },
        {
          "name": "Login as Patron",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "    pm.collectionVariables.set('patronToken', res.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patron@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in as seeded patron and saves token to {{patronToken}}."
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Get All Genres",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": ["{{baseUrl}}"],
              "path": ["genres"]
            },
            "description": "Public route to fetch all genres with book count."
          }
        },
        {
          "name": "Get Genre By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres/1",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "1"]
            },
            "description": "Public route to fetch a single genre and its books."
          }
        },
        {
          "name": "Create Genre (Librarian Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarianToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Philosophy\",\n  \"slug\": \"philosophy\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": ["{{baseUrl}}"],
              "path": ["genres"]
            },
            "description": "Creates a new genre. Requires LIBRARIAN token."
          }
        },
        {
          "name": "Update Genre (Librarian Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarianToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Modern Philosophy\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres/1",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "1"]
            },
            "description": "Updates an existing genre. Requires LIBRARIAN token."
          }
        },
        {
          "name": "Delete Genre (Librarian Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarianToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres/5",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "5"]
            },
            "description": "Deletes an existing genre without books. Requires LIBRARIAN token."
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get Books (Filtered, Searched, Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?genreId=1&search=Hobbit&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "genreId",
                  "value": "1"
                },
                {
                  "key": "search",
                  "value": "Hobbit"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Fetches books with optional query filtering by genreId, search query (title/author), and pagination (page, limit)."
          }
        },
        {
          "name": "Get Book By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["books", "1"]
            },
            "description": "Public route to fetch a single book with genre and reviews."
          }
        },
        {
          "name": "Create Book (Librarian Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarianToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Brave New World\",\n  \"author\": \"Aldous Huxley\",\n  \"isbn\": \"9780060850524\",\n  \"totalCopies\": 4,\n  \"genreId\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "description": "Creates a new book. Enforces DTO validation and LIBRARIAN guard."
          }
        },
        {
          "name": "Update Book (Librarian Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarianToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalCopies\": 6,\n  \"availableCopies\": 6\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["books", "1"]
            },
            "description": "Updates an existing book. Requires LIBRARIAN token."
          }
        },
        {
          "name": "Delete Book (Librarian Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarianToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/15",
              "host": ["{{baseUrl}}"],
              "path": ["books", "15"]
            },
            "description": "Deletes a book. Requires LIBRARIAN token."
          }
        }
      ]
    },
    {
      "name": "Users (Stretch)",
      "item": [
        {
          "name": "Get Authenticated User Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{patronToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            },
            "description": "Stretch Goal: Reads req.user using @Req() to fetch current authenticated user profile and reviews."
          }
        }
      ]
    }
  ]
}
